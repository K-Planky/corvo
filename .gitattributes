/mvnw text eol=lf
*.cmd text eol=crlf

# Everything under deploy/ is scp'd to a Linux VM and read by Linux tools, so it must be LF
# regardless of the checkout platform. An initdb script with CRLF fails inside the postgres
# container with "bad interpreter", and that would not surface until a volume rebuild.
deploy/** text eol=lf
*.sh text eol=lf
