# Production environment for compose.prod.yaml. Copy to `.env` ON THE VM and fill in real values.
# `.env` is git-ignored, never commit real secrets (Semgrep p/secrets guards this in CI).

# Domain whose A-record points at this VM. Caddy provisions HTTPS for it automatically.
DOMAIN=othello.example.com

# App image to run. deploy.yml overrides this with an immutable :<sha> tag per release.
APP_IMAGE=ghcr.io/cs-muic/ssc-y25t3-project-pothello-solo:latest

# Postgres credentials (the db service is created with these; the app connects with them).
DB_NAME=othello
DB_USER=othello
DB_PASSWORD=CHANGE_ME_strong_random_password

# HS256 JWT signing key, must be >= 32 bytes and random. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48
