# Local development environment template (spec §10/§13).
#
# Copy to `.env` (gitignored) and fill in real values. `docker compose` auto-loads `.env`; for
# `./mvnw spring-boot:run` on the host, export these first, e.g.:  set -a; . ./.env; set +a
#
# NEVER commit real secrets. In production these come from the host environment / Compose secrets.

# --- Database (compose Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=othello
DB_USER=othello
# Local-dev password; production sets a strong value via the environment.
DB_PASSWORD=othello

# --- JWT signing key (HS256, must be >= 32 bytes) ---
# Generate a strong one, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-strong-random-value-at-least-32-bytes
