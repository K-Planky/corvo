<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>dev.kplanky</groupId>
    <artifactId>othello-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>othello-server</name>
    <description>Real-time multiplayer Othello/Reversi game server</description>
    <properties>
        <java.version>21</java.version>
        <!-- jjwt is not managed by the Spring Boot BOM; pin it explicitly. -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Hibernate / Spring Data JPA (M2). Brings spring-jdbc transitively, so JdbcTemplate
             (used by the Flyway migration test) is still autoconfigured. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security (M3): stateless JWT auth + BCrypt password hashing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Bean Validation (@Valid on request DTOs). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- WebSocket/STOMP (M8): live push of AI/opponent moves. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- jjwt: sign/verify HS256 JWTs. impl + jackson are runtime-only per jjwt's split API. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway migrations (db/migration). Spring Boot 4 extracted the Flyway autoconfiguration
             into its own spring-boot-flyway module (it is NOT in spring-boot-autoconfigure and is
             not pulled in transitively by flyway-core); it brings flyway-core with it.
             flyway-database-postgresql is required for Postgres support since Flyway 10+. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security test support (@WithMockUser, security-aware MockMvc helpers). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 4 split the MockMvc test slice out of starter-test into its own module;
             needed for @AutoConfigureMockMvc / MockMvc controller tests (here and in M4/M8). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers (2.x) for real-Postgres integration tests; @ServiceConnection wires the
             container to the DataSource. Module artifactIds gained a testcontainers- prefix in 2.x. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Tests need JWT_SECRET (no in-source default since M3.3); inject an obviously-fake
                 test-only value here as a real env var so the ${JWT_SECRET} placeholder resolves.
                 Datasource creds are unneeded: Testcontainers @ServiceConnection overrides them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <JWT_SECRET>test-only-jwt-signing-secret-not-used-in-production-0123456789</JWT_SECRET>
                    </environmentVariables>
                    <!-- Shrink the AI think-time so integration tests that play out vs-AI games don't
                         pay the real per-move budget. Caps every difficulty to 10 ms; depth-1 still
                         completes (it's uninterruptible), so the bot plays a real legal move fast.
                         Wired as a system property (not @TestPropertySource) on purpose: it leaves
                         every @SpringBootTest sharing ONE cached Spring context, where a per-class
                         property override would fragment the cache and slow CI. Trade-off: running
                         these tests straight from an IDE (no Surefire) falls back to the 1 s default
                         cap — pass -Dbot.sync-think-cap=10ms there if the vs-AI tests feel slow. -->
                    <systemPropertyVariables>
                        <bot.sync-think-cap>10ms</bot.sync-think-cap>
                        <!-- Default the vs-AI reply to synchronous in-request so the deterministic
                             service/REST tests can assert post-reply state right after submitMove
                             without a background worker racing them. The async path (prod default) is
                             covered by GameAsyncAiReplyTest, which opts back in via @TestPropertySource
                             (a separate, intentional context). -->
                        <bot.async-reply>false</bot.async-reply>
                        <!-- Disable the PvP turn-clock background sweep suite-wide (M10) so a timer
                             never races the deterministic integration tests. TurnClockForfeitTest
                             drives TurnClockService.sweep() explicitly instead. -->
                        <pvp.clock.scheduler-enabled>false</pvp.clock.scheduler-enabled>
                        <!-- Likewise disable the opponent-disconnect grace sweep suite-wide (M11.2);
                             OpponentDisconnectPolicyTest drives DisconnectPolicyService.sweep()
                             explicitly so no timer races it. -->
                        <pvp.disconnect.scheduler-enabled>false</pvp.disconnect.scheduler-enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
