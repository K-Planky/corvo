# Template for /srv/apps/othello/.env ON THE VM. Never committed, never leaves the box.
# Create it once by hand before the first deploy; CI ships compose.yaml and the image, never
# secrets. `docker compose` auto-loads this file from the stack directory.
#
#   install -m 600 /dev/null /srv/apps/othello/.env   # then fill in below
#
# Generate fresh values, do not reuse another app's:
#   DB_ADMIN_PASSWORD / DB_APP_PASSWORD:  openssl rand -base64 36
#   JWT_SECRET:   openssl rand -base64 48    (HS256, must be >= 32 bytes)

# TWO database roles, deliberately. The admin role is the postgres superuser: initdb, the
# healthcheck and the nightly pg_dumpall use it (pg_dumpall reads pg_authid, which needs
# superuser). The app role is what Spring and Flyway connect as, and it is NOT a superuser, so a
# SQL injection cannot reach COPY ... TO PROGRAM or pg_read_file. See initdb/01-app-role.sh.
# DB_ADMIN_USER must stay `othello`: that is the POSTGRES_USER this volume was initialized with.
DB_NAME=othello

DB_ADMIN_USER=othello
DB_ADMIN_PASSWORD=

DB_APP_USER=othello_app
DB_APP_PASSWORD=
JWT_SECRET=

# Optional. CI exports an immutable :sha tag over this on every deploy; it only matters for
# manual `docker compose up` and for pinning an old image during a rollback.
APP_IMAGE=ghcr.io/k-planky/corvo:latest
